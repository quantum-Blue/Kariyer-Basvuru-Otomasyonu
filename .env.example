# ============================================================================
# OTONOM KARİYER ASİSTANI — ÖRNEK ORTAM DEĞİŞKENLERİ (.env.example)
# ============================================================================
# Bu dosyayı '.env' adıyla kopyalayın ve kendi bilgilerinizle doldurun.
# DİKKAT: Gerçek '.env' dosyasını ASLA Git'e commit etmeyin!

# 1. Google Gemini API (Free Tier)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Gmail SMTP Ayarları (Uygulama Şifresi / App Password kullanılmalıdır)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_16_char_gmail_app_password"
SENDER_NAME="Muhammed Enes BAL"

# 3. Aday Bağlantıları (Spam filtrelerine takılmamak için PDF eki yerine URL kullanılır)
CV_URL_TR="https://drive.google.com/your-turkish-cv-link"
CV_URL_EN="https://drive.google.com/your-english-cv-link"
PORTFOLIO_URL="https://github.com/your-username"
GITHUB_URL="https://github.com/your-username"
LINKEDIN_URL="https://linkedin.com/in/your-username"
